# Copy to .env.local for local development (`cp .env.example .env.local` then fill values).

# Postgres (big-vps fleet-postgres). In Coolify use PgBouncer:
#   postgres://store_bbconsult:<password>@fleet-pgbouncer:6432/store_bbconsult
DATABASE_URL=
# Random secret, at least 32 characters (signs session cookies and email links): `openssl rand -hex 32`
AUTH_JWT_SECRET=
# Absolute directory for uploaded files (Coolify: /app/storage on a persistent volume)
STORAGE_ROOT=

RESEND_API_KEY=
# Verified sender in Resend, e.g. "B.B. Travel <noreply@yourdomain.com>"
RESEND_FROM=
# Comma-separated admin inboxes for website form notifications (defaults to brand email if unset)
ADMIN_NOTIFY_EMAILS=
# Local dev: http://localhost:3000  |  Production: https://your-domain.com  (used in email links)
APP_BASE_URL=
GOOGLE_SITE_VERIFICATION=
